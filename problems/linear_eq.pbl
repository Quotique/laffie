problem {
    target find(x);

    x == 1;
};

problem {
    target find(x);

    x in set(1);
};

problem {
    target find(x);

    x in set(1, (sqrt(2) + 5)/2 );
};

problem {
    target find(x);

    --x == 1;
};

problem {
    target find(x);

    2*x+5 == 0;
};

problem {
    target find(x);

    2*x-5 == 0;
};

problem {
    target find(x);

    2*x-5+t == 0;
    t is known;
};

problem {
    target find(x);

    2*x-t == 0;
    t is known;
};
