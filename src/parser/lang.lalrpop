use std::iter::FromIterator;
use trees::linked::fully::{tr, Tree, Forest};

grammar;

pub Statements = Vector<Statement, Semicolon>;

Vector<T, Delim> : Vec<T> = {
    <v:(<T> Delim)*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

Statement: Tree<String> = {
    Problem,
    Declare,
    RuleExt,
    Predicate,
};

Problem: Tree<String> = {
    "problem" "{" <c:Conditions> "}" => {
        let mut t = tr(String::from("Problem"));
        t.append(Forest::from_iter(c.iter().map(|x| x.clone())));
        t
    },
};

Conditions = Vector<Condition, Semicolon>;

Condition: Tree<String> = {
    Rule,
    Predicate,
    Target,
};

Target: Tree<String> = {
    "target" <c:Str> "(" <p:Predicate> ")" => tr(String::from("Target")) /tr(String::from(c))/p,
    "target" <c:Str> <s:Str> => tr(String::from("Target")) /tr(String::from(c))/tr(String::from(s)),
};

Attributes = Vector<Eval, Comma>;

Declare: Tree<String> = {
    "symbol" <s:ExtStr> => tr(String::from("Declare")) /(tr(String::from("Symbol"))/tr(String::from(s))),
    "symbol" <s:ExtStr> "{" "attr" <a:Attributes> "}" => {
        let mut t = tr(String::from("Attrs"));
        t.append(Forest::from_iter(a.iter().map(|x| x.clone())));
        tr(String::from("Declare")) /(tr(String::from("Symbol"))/tr(String::from(s))) /t
    }
};

Tier<Op, NextTier>: Tree<String> = {
    <l:Tier<Op, NextTier> > <o:Op> <r:NextTier> => tr(String::from(o))/l/r,
    NextTier
};

Predicate = Tier<LogicOr, AndPred>;
AndPred = Tier<LogicAnd, ElemPred>;

LogicOr = { "||" };
LogicAnd = { "&&" };

ElemPred: Tree<String> = {
    "(" <p:Predicate> ")" => p,
    <l:Expr> <o:PredOp> <r:Expr> => tr(String::from(o))/l/r,
};

PredOp = {
    "is",
    "in",
    "==",
    "!=",
    "<=",
    ">=",
    "<",
    ">",
};

RuleExt: Tree<String> = {
    <o:Rule> => o,
    "rule" "{" <r:Rule> ";" <p:Predicates> "}" => {
        let mut t = tr(String::from("Rule"));
        t.push_back(r);
        t.append(Forest::from_iter(p.iter().map(|x| x.clone())));
        t
    }
}

Predicates = Vector<Predicate, Semicolon>;

Rule: Tree<String> = {
    <l:Predicate> <o:RuleOp> <r:Predicate> => tr(String::from(o))/l/r,
    <l:Expr> <o:RuleOp> <r:Expr> => tr(String::from(o))/l/r,
};

RuleOp = {
    "=>",
    "<=>",
};

Expr = Tier<SumOp, Factor>;
Factor = Tier<MulOp, Eval>;

SumOp = {
    "+",
    "-",
};

MulOp = {
    "*",
    "/",
};

Eval: Tree<String> = {
    "(" <Expr> ")" => <>,
    Term => tr(String::from(<>)),
    <t:Term> "(" <a:Args> ")" => {
        let mut t = tr(String::from(t));
        t.append(Forest::from_iter(a.iter().map(|x| x.clone())));
        t
    },
    <o:SumOp> <e:Eval> => tr(String::from(o))/e
    ,
};

Args = Vector<Expr, Comma>;

Term : &'input str = {
    <s:Str> => s,
};

SystemOp = { "+", "-", "*", "/", }
Str = { 
    r"[A-Za-z0-9_.]+",
    <s:r#"".+""#> => &s[1..s.len()-1]
};

ExtStr = { r"[A-Za-z0-9_.]+", "is", "in", "==", "!=", "<=", ">=", "<", ">", "+", "-", "*", "/", };

Semicolon = { ";", };

Comma = { ",", };
