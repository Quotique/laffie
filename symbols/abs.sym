// Модуль (absolute value). Display сейчас не поддерживает bracket-стиль
// `|a|`, поэтому выводится как `abs(a)` через стандартный prefix-call.

symbol abs {}

rule abs(a) is known <=> true {
    attr level(0),goal(prove(abs(a) is known));

    a is known;
}

rule abs(a) => a {
    attr replace,level(1),goal(transform(x));

    a >= 0;
}

rule abs(a) => -a {
    attr replace,level(1),goal(transform(x));

    a < 0;
}
