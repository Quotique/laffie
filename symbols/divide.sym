symbol / {
    attr infix(200),display("/")
};

rule {
    attr level(0),problem_target(proof(a/b is known));

    a/b is known <=> true;

    a is known,
    b is known;
};

rule {
    attr level(2),problem_target(transform(x)),subtree,replace;

    a/b + c/d + e <=> (a*d + b*c)/(b*d) + e;
};

rule {
    attr level(1),problem_target(proof(a/b != 0));

    a/b != 0 <=> a != 0;

    a is known;
};
