symbol / {
    attr infix(200),display("/")
}

rule {
    attr level(0),purpose(proof(a/b is known));

    a/b is known <=> true;

    a is known,
    b is known;
}

rule {
    attr level(0),purpose(transform(x)),replace;

    -a/b => (-a)/b;
}

rule {
    attr level(2),purpose(transform(x)),replace,zero(e);

    a/b + c/d + e <=> (a*d + b*c)/(b*d) + e;
}

rule {
    attr level(3),purpose(transform(x)),replace;

    a/b + c <=> (a + b*c)/b;
}

rule {
    attr level(1),purpose(transform(x)),replace;

    c * (a/b) <=> (a*c)/b;
}

rule {
    attr level(2),purpose(proof(a/b != 0));

    a/b != 0 <=> a != 0;

    a is known;
}

rule {
    attr level(3),purpose(proof(a/b != c));

    a/b != c <=> a != c*b;

    a is known;
}

rule {
    attr level(2),purpose(find(x));

    a/b == 0 => a == 0 && b != 0;
}
