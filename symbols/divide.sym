symbol / {
    attr infix(200),display("/");
}

rule {
    attr level(0),goal(prove(a/b is known));

    a/b is known <=> true;

    a is known,
    b is known;
}

rule {
    attr level(0),goal(transform(x)),replace;

    -a/b => (-a)/b;
}

rule {
    attr level(2),goal(transform(x)),replace,zero(e);

    a/b + c/d + e <=> (a*d + b*c)/(b*d) + e;
}

rule {
    attr level(3),goal(transform(x)),replace;

    a/b + c <=> (a + b*c)/b;
}

rule {
    attr level(1),goal(transform(x)),replace;

    c * (a/b) <=> (a*c)/b;
}

rule {
    attr level(2),goal(prove(a/b != 0));

    a/b != 0 <=> a != 0;

    a is known;
}

rule {
    attr level(3),goal(prove(a/b != c));

    a/b != c <=> a != c*b;

    a is known;
}

rule {
    attr level(2),goal(find(x, ..));

    a/b == 0 => a == 0 && b != 0;
}

rule {
    attr level(0),goal(prove(a/b <= 0));

    a/b <= 0 <=> a*b <= 0;

    b != 0;
}

rule {
    attr level(0),goal(prove(a/b > 0));

    a/b >= 0 <=> a*b >= 0;

    b != 0;
}

rule {
    attr level(0),goal(prove(a/b > 0));

    a/b > 0 <=> a*b > 0;
}
