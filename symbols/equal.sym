symbol == {
    attr infix(500),display("=")
};

rule {
    attr replace,level(0),problem_target(find(x)),id(move_left);

    a == b <=> a - b == 0;

    !symbolic_eq(b, 0);
};

rule {
    attr level(1),problem_target(find(x)),one(a),zero(b),block(move_left);

    x*a + b == 0 => x == - b/a;

    a != 0,
    b is known;
};

