symbol factorization {
    py
"
import json

def calculator(root, level):
    root_data = json.loads(root)
    if root_data[\"data\"][\"Symbol\"] != \"factorization\":
        return root, False

    if len(root_data[\"children\"]) == 1:
        arg = root_data[\"children\"][0]
        if \"Number\" in arg[\"data\"]:
            num = int(arg[\"data\"][\"Number\"])

            factors = []
            d = 2
            while d * d <= num:
                while num % d == 0:
                    factors.append({\"data\": {\"Number\": f\"{d}\"}})
                    num //= d
                d += 1
            if num > 1:
                factors.append({\"data\": {\"Number\": f\"{num}\"}})

            result = {\"data\": {\"Symbol\": \"set\"}, \"children\": factors}

            return json.dumps(result), True

    return root, False
";
}
