symbol free_term {
    py
"
exec(SYMPY_CONVERT_SRC)

def calculator(root, level):
    if root.symbol != 'free_term' or len(root) != 2:
        return None

    expr_node = root[0]
    var_node = root[1]

    if not var_node.is_variable:
        return None

    var_name = var_node.name
    x = sympy.Symbol(var_name)

    expr = to_sympy(expr_node, {var_name: x})
    if expr is None:
        return None

    try:
        p = sympy.Poly(expr, x)
        c = p.nth(0)
        return from_sympy(c, var_name, Term)
    except (sympy.GeneratorsNeeded, sympy.PolynomialError):
        return None
";
}
