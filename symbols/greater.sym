symbol > {
    attr infix(400),display(">");
}

// Правила доказательства неравенств (см. doc/ru/inequalities.md).
// `<=>` (Equivalence) применяется в одну сторону pattern→resolution, но
// пускается к goal-терму prove — оттого обязано быть истинной эквивалентностью.
// `=>` — только forward на не-goal термах. Правило лежит в файле корня паттерна.

// Квадрат строго больше любого отрицательного числа.
rule {
    attr level(1),goal(prove(x));

    a^2 > b <=> true;

    b < 0;
}

// x^2 + c > b при b - c < 0. Специфично для `a^2 + c`: общий перенос
// `a + c > b <=> a > b - c` взрывал sqrt-поиск на ОДЗ (см. doc).
rule {
    attr level(1),goal(prove(x));

    a^2 + c > b <=> true;

    c is known,
    b - c < 0;
}

// Трёхчлен со старшим a > 0 и отрицательным дискриминантом положителен:
// `(x-1)^2 + 3 > 2` доходит сюда раскрытым.
rule {
    attr level(1),goal(prove(t)),one(a),one(b);

    a*x^2 + b*x + c > d <=> true;

    a is known,
    b is known,
    c is known,
    d is known,
    a > 0,
    b^2 - 4*a*(c - d) < 0;
}

// Квадрат ненулевого положителен.
rule {
    attr level(2),goal(prove(x));

    a^2 > 0 <=> a != 0;
}

// Ослабление границы: из a > b следует цель a > c при b >= c.
rule {
    attr level(1),goal(prove(a > c));

    a > b => a > c;

    b >= c,
    !symbolic_eq(b, c);
}

// Нестрогое следствие строгого (те же операнды) — нужно для транзитивности.
rule {
    attr level(1),goal(prove(a >= b));

    a > b => a >= b;
}

// Нестрогое следствие строгого с ослаблением границы.
rule {
    attr level(1),goal(prove(a >= c));

    a > b => a >= c;

    b >= c;
}

// Сумма оценок: из a > b и c > e - b следует a + c > e.
rule {
    attr level(2),goal(prove(a + c > e));

    a > b => a + c > e;

    c > e - b;
}

// Нестрогая сумма из строгой посылки.
rule {
    attr level(2),goal(prove(a + c >= e));

    a > b => a + c >= e;

    c >= e - b;
}

// Знак произведения: положительное на положительное.
rule {
    attr level(2),goal(prove(a * c > 0));

    a > 0 => a * c > 0;

    c > 0;
}

// Неотрицательность произведения.
rule {
    attr level(2),goal(prove(a * c >= 0));

    a > 0 => a * c >= 0;

    c >= 0;
}

// Знак степени: положительное основание в любой нат. степени положительно.
rule {
    attr level(1),goal(prove(a^c > 0));

    a > 0 => a^c > 0;
}

// Неотрицательная степень плюс известная константа больше меньшей границы:
// a^c + d > b при a >= 0, b - d < 0. Обобщает `a^2 + c > b` на нечётные степени
// (там неотрицательность безусловна, тут — из требования a >= 0).
rule {
    attr level(1),goal(prove(x));

    a^c + d > b <=> true;

    a >= 0,
    d is known,
    b - d < 0;
}

// Чётная степень плюс остаток, превышающий границу (x^2 + y^2 + 1 > 0):
// a^c >= 0 при чётном c, значит a^c + d > b при d > b.
rule {
    attr level(1),goal(prove(x));

    a^c + d > b <=> true;

    c is even,
    d > b;
}

// Монотонное масштабирование на положительный множитель: x*z > y*z при
// x > y, z > 0.
rule {
    attr level(2),goal(prove(a * c > b * c));

    a > b => a * c > b * c;

    c > 0;
}

// Произведение двух оценок против числа: a*c > e из a > b при b > 0, c > 0 и
// b*c >= e (x*y > 6 из x>2, y>3 → требование 2*y >= 6). Требование b*c —
// умножение, не деление (деление в требовании роняет решатель при нуле).
rule {
    attr level(2),goal(prove(a * c > e));

    a > b => a * c > e;

    b > 0,
    c > 0,
    b * c >= e;
}

// Масштабирование константой до числовой границы: c*a >= e из a > b при c > 0 и
// c*b >= e (2*y >= 6 из y>3 → требование 2*3 >= 6, чисто числовое). Замыкает
// требование правила выше без деления.
rule {
    attr level(2),goal(prove(c * a >= e));

    a > b => c * a >= e;

    c > 0,
    c * b >= e;
}

// Опровергнутое следствие условий: решений нет.
rule {
    attr level(1),goal(find(x, ..));

    a > c => x in empty_set;

    a is known,
    c is known,
    a <= c;
}

// Квадратичная средняя против суммы (QM-AM): из a + b > d при d >= 0 следует
// a^2 + b^2 > c при d*d >= 2*c, т.к. 2*(a^2+b^2) >= (a+b)^2 > d^2 >= 2*c
// (a^2 + b^2 > 2 из a + b > 2 → требование 2*2 >= 2*2, чисто числовое).
rule {
    attr level(2),goal(prove(a^2 + b^2 > c));

    a + b > d => a^2 + b^2 > c;

    d >= 0,
    d * d >= 2 * c;
}

// SOS со строгостью из посылки: a^2 + b^2 + c^2 + 3 - 2a - 2b - 2c =
// (a-1)^2 + (b-1)^2 + (c-1)^2, что строго положительно ровно тогда, когда
// не все три равны 1 — истинная эквивалентность. Паттерн — в
// transform-раскрытой форме цели (беклог §6; после пересмотра transform
// вернуть запись `... + 3 > 2*(a + b + c)`).
rule {
    attr level(1),goal(prove(x));

    a^2 + b^2 + c^2 + 3 > 2*a + 2*b + 2*c <=> a != 1 || b != 1 || c != 1;
}

// Каноническая форма цели prove: всё в правую часть (беклог §13). Шаблон
// связан с целью через goal(...): иначе переписал бы и выведенные неравенства.
rule {
    attr level(0),goal(prove(a > b));

    a > b <=> 0 < a - b;
}
