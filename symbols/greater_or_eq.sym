symbol >= {
    attr infix(400),display("≥");
}

// Правила доказательства неравенств (см. doc/ru/inequalities.md).
// `<=>` (Equivalence) применяется в одну сторону pattern→resolution, но
// пускается к goal-терму prove — оттого обязано быть истинной эквивалентностью.
// `=>` — только forward на не-goal термах. Правило лежит в файле корня паттерна.

// Включая x^2 >= 0 (b == 0 удовлетворяет b <= 0).
rule a^2 >= b <=> true {
    attr level(1),goal(prove(x));

    b <= 0;
}

// x^2 + c >= b при b - c <= 0. Специфично для `a^2 + c` (см. greater.sym).
rule a^2 + c >= b <=> true {
    attr level(1),goal(prove(x));

    c is known,
    b - c <= 0;
}

// Трёхчлен со старшим a > 0 и неположительным дискриминантом неотрицателен.
rule a*x^2 + b*x + c >= d <=> true {
    attr level(1),goal(prove(t)),one(a),one(b);

    a is known,
    b is known,
    c is known,
    d is known,
    a > 0,
    b^2 - 4*a*(c - d) <= 0;
}

rule a >= b => a >= c {
    attr level(1),goal(prove(a >= c));

    b >= c,
    !symbolic_eq(b, c);
}

rule a >= b => a > c {
    attr level(1),goal(prove(a > c));

    b > c;
}

rule a >= b => a + c >= e {
    attr level(2),goal(prove(a + c >= e));

    c >= e - b;
}

rule a >= b => a + c > e {
    attr level(2),goal(prove(a + c > e));

    c > e - b;
}

rule a >= 0 => a * c >= 0 {
    attr level(2),goal(prove(a * c >= 0));

    c >= 0;
}

// Знак степени: неотрицательное основание в любой нат. степени неотрицательно.
rule a >= 0 => a^c >= 0 {
    attr level(1),goal(prove(a^c >= 0));
}

// Модуль неотрицателен (безусловно).
rule abs(a) >= b <=> true {
    attr level(1),goal(prove(x));

    b <= 0;
}

// Чётная степень неотрицательна безусловно (x^4 >= 0).
rule a^c >= b <=> true {
    attr level(1),goal(prove(x));

    c is even,
    b <= 0;
}

// Модуль не меньше своего аргумента (безусловно): abs(x) >= x.
rule abs(a) >= a <=> true {
    attr level(1),goal(prove(x));
}

// Опровергнутое следствие условий: решений нет.
rule a >= c => x in empty_set {
    attr level(1),goal(find(x, ..));

    a is known,
    c is known,
    a < c;
}

// Каноническая форма цели prove: всё в правую часть (беклог §13). Шаблон
// связан с целью через goal(...): иначе переписал бы и выведенные неравенства.
rule a >= b <=> 0 <= a - b {
    attr level(0),goal(prove(a >= b));
}
