symbol is_polynomial {
    py
"
exec(open('symbols/py/sympy_convert.py').read())

def calculator(root, level):
    if root.symbol != 'is_polynomial' or len(root) != 2:
        return None

    expr_node = root[0]
    var_node = root[1]

    if not var_node.is_variable:
        return None

    var_name = var_node.name
    x = sympy.Symbol(var_name)

    expr = to_sympy(expr_node, {var_name: x})
    if expr is None:
        return None

    try:
        sympy.Poly(expr, x)
        return Term('true')
    except (sympy.GeneratorsNeeded, sympy.PolynomialError):
        return Term('false')
";
}
