symbol < {
    attr infix(400),display("<");
}

// Правила доказательства неравенств (см. doc/ru/inequalities.md).
// `<=>` (Equivalence) применяется в одну сторону pattern→resolution, но
// пускается к goal-терму prove — оттого обязано быть истинной эквивалентностью.
// `=>` — только forward на не-goal термах. Правило лежит в файле корня паттерна.

rule {
    attr level(1),goal(prove(a < c));

    a < b => a < c;

    b <= c,
    !symbolic_eq(b, c);
}

rule {
    attr level(1),goal(prove(a <= c));

    a < b => a <= c;

    b <= c;
}

rule {
    attr level(2),goal(prove(a + c < e));

    a < b => a + c < e;

    c < e - b;
}

// Отрицательное на отрицательное.
rule {
    attr level(2),goal(prove(a * c > 0));

    a < 0 => a * c > 0;

    c < 0;
}

// Отрицательное на положительное.
rule {
    attr level(2),goal(prove(a * c < 0));

    a < 0 => a * c < 0;

    c > 0;
}

// Ограниченный сверху квадрат: a^2 < c из a < b при a >= 0 и b*b <= c.
rule {
    attr level(2),goal(prove(a^2 < c));

    a < b => a^2 < c;

    a >= 0,
    b * b <= c;
}

// Линейное убывание с верхней границей: e - a > f из a < b при e - b >= f.
rule {
    attr level(2),goal(prove(e - a > f));

    a < b => e - a > f;

    e - b >= f;
}

// Опровергнутое следствие условий: решений нет.
rule {
    attr level(1),goal(find(x, ..));

    a < c => x in empty_set;

    a is known,
    c is known,
    a >= c;
}

// AM-GM дробей, нижняя: из 0 < a*b следует c <= a/b + b/a при c <= 2,
// т.к. a/b + b/a = (a^2 + b^2)/(a*b) >= 2 при a*b > 0.
rule {
    attr level(2),goal(prove(c <= a/b + b/a));

    0 < a * b => c <= a/b + b/a;

    c <= 2;
}

// AM-GM дробей, верхняя: из a*b < 0 следует a/b + b/a <= c при -2 <= c
// (зеркало нижней: при a*b < 0 сумма не превосходит -2).
rule {
    attr level(2),goal(prove(a/b + b/a <= c));

    a * b < 0 => a/b + b/a <= c;

    -2 <= c;
}

// Сумма с обратным при отрицательном основании: из a < 0 следует
// a + 1/a < c при -2 < c, т.к. a + 1/a <= -2 при a < 0.
rule {
    attr level(2),goal(prove(a + 1/a < c));

    a < 0 => a + 1/a < c;

    -2 < c;
}

// Симметричные AM-GM-тройки на положительных a, b, c. Паттерны целей — в
// transform-раскрытой форме (беклог §6; после пересмотра transform вернуть
// записи с факторизованными частями).

// (ab-1)^2 + (a-b)^2 > 0 при 0 < a, 0 < b и не(a = b = 1):
// a^2 b^2 + a^2 + b^2 + 1 > 4ab.
rule {
    attr level(2),goal(prove(a^2*b^2 + a^2 + b^2 + 1 > 4*a*b));

    0 < a => a^2*b^2 + a^2 + b^2 + 1 > 4*a*b;

    0 < b,
    a != 1 || b != 1;
}

// AM-GM шести членов: 6abc <= a^2 b + a b^2 + a^2 c + a c^2 + b^2 c + b c^2
// (цель — раскрытие ab(a+b) + bc(b+c) + ac(a+c)).
rule {
    attr level(2),goal(prove(6*a*b*c <= a*b*(a + b) + b*c*(b + c) + a*c*(a + c)));

    0 < a => 6*a*b*c <= a^2*b + a*b^2 + a^2*c + a*c^2 + b^2*c + b*c^2;

    0 < b,
    0 < c;
}

// AM-GM девяти членов: 9abc <= (a + b + c)*(a^2 + b^2 + c^2) в раскрытии.
rule {
    attr level(2),goal(prove(9*a*b*c <= (a + b + c)*(a^2 + b^2 + c^2)));

    0 < a => 9*a*b*c <= a^3 + a^2*b + a^2*c + a*b^2 + a*c^2 + b^3 + b^2*c + b*c^2 + c^3;

    0 < b,
    0 < c;
}

// Попарно a^2 b + a b^2 <= a^3 + b^3 (т.к. (a + b)*(a - b)^2 >= 0):
// сумма по трём парам — раскрытие ab(a+b) + bc(b+c) + ac(a+c) <= 2(a^3+b^3+c^3).
rule {
    attr level(2),goal(prove(a*b*(a + b) + b*c*(b + c) + a*c*(a + c) <= 2*(a^3 + b^3 + c^3)));

    0 < a => a^2*b + a*b^2 + a^2*c + a*c^2 + b^2*c + b*c^2 <= 2*a^3 + 2*b^3 + 2*c^3;

    0 < b,
    0 < c;
}

// Степенная средняя кубов: (a + b + c)^3 <= 9*(a^3 + b^3 + c^3) в раскрытии.
rule {
    attr level(2),goal(prove((a + b + c)^3 <= 9*(a^3 + b^3 + c^3)));

    0 < a => a^3 + 3*a^2*b + 3*a^2*c + 3*a*b^2 + 6*a*b*c + 3*a*c^2 + b^3 + 3*b^2*c + 3*b*c^2 + c^3
        <= 9*a^3 + 9*b^3 + 9*c^3;

    0 < b,
    0 < c;
}

// Каноническая форма цели prove: всё в правую часть (беклог §13). Шаблон
// связан с целью через goal(...): иначе переписал бы и выведенные неравенства.
rule {
    attr level(0),goal(prove(a < b));

    a < b <=> 0 < b - a;

    !symbolic_eq(a, 0);
}

// Поглощение |f·a^j| ≤ |f|/2·(a^k + a^l) при чётных k, l и k + l = 2j;
// остаток — подзадачей.
rule {
    attr id(absorb_pow),level(1),goal(prove(x)),one(e),one(g),zero(l),zero(d);

    0 < e*a^k + f*a^j + g*a^l + d <=> true;

    k is even, l is even, k + l == 2*j,
    e is number, f is number, g is number,
    2*e >= abs(f), 2*g >= abs(f),
    0 < (2*e - abs(f))*a^k + (2*g - abs(f))*a^l + 2*d;
}

// То же для произвольных A, B: |f·A·B| ≤ |f|/2·(A^2 + B^2).
rule {
    attr id(absorb_quad),level(1),goal(prove(x)),one(e),one(f),one(g),zero(d);

    0 < e*A^2 + f*A*B + g*B^2 + d <=> true;

    e is number, f is number, g is number,
    2*e >= abs(f), 2*g >= abs(f),
    0 < (2*e - abs(f))*A^2 + (2*g - abs(f))*B^2 + 2*d;
}

// Чётная степень с неотрицательным коэффициентом плюс положительный остаток.
rule {
    attr level(1),goal(prove(x)),one(e);

    0 < e*a^c + d <=> true;

    c is even,
    e is number,
    0 <= e,
    0 < d;
}
