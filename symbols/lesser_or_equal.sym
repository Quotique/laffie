symbol <= {
    attr infix(400),display("≤");
}

// Правила доказательства неравенств (см. doc/ru/inequalities.md).
// `<=>` (Equivalence) применяется в одну сторону pattern→resolution, но
// пускается к goal-терму prove — оттого обязано быть истинной эквивалентностью.
// `=>` — только forward на не-goal термах. Правило лежит в файле корня паттерна.

rule {
    attr level(1),goal(prove(a <= c));

    a <= b => a <= c;

    b <= c,
    !symbolic_eq(b, c);
}

rule {
    attr level(1),goal(prove(a < c));

    a <= b => a < c;

    b < c;
}

rule {
    attr level(2),goal(prove(a + c <= e));

    a <= b => a + c <= e;

    c <= e - b;
}

// Неположительное на неотрицательное.
rule {
    attr level(2),goal(prove(a * c <= 0));

    a <= 0 => a * c <= 0;

    c >= 0;
}

// Опровергнутое следствие условий: решений нет.
rule {
    attr level(1),goal(find(x, ..));

    a <= c => x in empty_set;

    a is known,
    c is known,
    a > c;
}

// Степенная средняя для чётной степени: из c <= a + b при 0 <= c следует
// c^n/m <= a^n + b^n при чётном n и 2^n <= 2*m, т.к.
// c^n <= (a+b)^n <= 2^(n-1)*(a^n + b^n) <= m*(a^n + b^n)
// (a^2/2 <= b^2 + c^2 из a <= b + c, 0 <= a → требование 2^2 <= 2*2).
rule {
    attr level(2),goal(prove(c^n / m <= a^n + b^n));

    c <= a + b => c^n / m <= a^n + b^n;

    0 <= c,
    n is even,
    2^n <= 2 * m;
}

// Тройная QM-AM: из d <= a + b + e при 0 <= d следует c <= a^2 + b^2 + e^2
// при 3*c <= d*d, т.к. d^2 <= (a+b+e)^2 <= 3*(a^2+b^2+e^2)
// (3 <= a^2 + b^2 + c^2 из 3 <= a + b + c → требование 3*3 <= 9).
rule {
    attr level(2),goal(prove(c <= a^2 + b^2 + e^2));

    d <= a + b + e => c <= a^2 + b^2 + e^2;

    0 <= d,
    3 * c <= d * d;
}

// Безусловный SOS-факт: 3ab + 3bc + 3ca <= (a + b + c)^2, поскольку
// разность равна ((a-b)^2 + (b-c)^2 + (c-a)^2)/2 >= 0. Паттерн — на
// ПОЛНОСТЬЮ раскрытой цели (обе части — плоские суммы): goal-терм
// prove-задачи до примерки Equivalence-правил переписывается
// transform-упрощением, раскрывающим скобки, поэтому паттерн в
// «естественной» записи `3*(a*b + ...) <= (a + b + c)^2` цель уже не
// застаёт. После пересмотра transform-подзадач (беклог §6) вернуть
// правило к канонической записи `3*(a*b + b*c + a*c) <= (a + b + c)^2`.
rule {
    attr level(1),goal(prove(x));

    3*a*b + 3*b*c + 3*a*c <= 2*a*b + 2*b*c + 2*a*c + a^2 + b^2 + c^2 <=> true;
}

// Каноническая форма цели prove: всё в правую часть (беклог §13). Шаблон
// связан с целью через goal(...): иначе переписал бы и выведенные неравенства.
rule {
    attr level(0),goal(prove(a <= b));

    a <= b <=> 0 <= b - a;

    !symbolic_eq(a, 0);
}

// Поглощение |f·a^j| ≤ |f|/2·(a^k + a^l) при чётных k, l и k + l = 2j;
// остаток — подзадачей.
rule {
    attr id(absorb_pow_le),level(1),goal(prove(x)),one(e),one(g),zero(l),zero(d);

    0 <= e*a^k + f*a^j + g*a^l + d <=> true;

    k is even, l is even, k + l == 2*j,
    e is number, f is number, g is number,
    2*e >= abs(f), 2*g >= abs(f),
    0 <= (2*e - abs(f))*a^k + (2*g - abs(f))*a^l + 2*d;
}

// То же для произвольных A, B: |f·A·B| ≤ |f|/2·(A^2 + B^2).
rule {
    attr id(absorb_quad_le),level(1),goal(prove(x)),one(e),one(f),one(g),zero(d);

    0 <= e*A^2 + f*A*B + g*B^2 + d <=> true;

    e is number, f is number, g is number,
    2*e >= abs(f), 2*g >= abs(f),
    0 <= (2*e - abs(f))*A^2 + (2*g - abs(f))*B^2 + 2*d;
}

// Чётная степень с неотрицательным коэффициентом плюс неотрицательный остаток.
rule {
    attr level(1),goal(prove(x)),one(e),zero(d);

    0 <= e*a^c + d <=> true;

    c is even,
    e is number,
    0 <= e,
    0 <= d;
}
