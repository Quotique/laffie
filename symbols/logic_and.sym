symbol && {
    attr infix(500),display("&"),associative,commutative
}

rule {
    attr level(2),purpose(transform(x)),replace;

    a && b <=> b;

    a is true;
}

rule {
    attr level(2),purpose(transform(x)),replace;

    a && b <=> a;

    a is false;
}

rule {
    attr level(1),purpose(transform(x)),replace;

    a == b && c =>  a == b && replace(a == b, c);

    a is variable;
}

rule {
    attr level(3),purpose(transform(x)),replace;

    a && (b || c) => (a && b) || (a && c);
}
