symbol && {
    attr infix(500),display("&"),associative,commutative
};

rule {
    attr level(0),problem_target(transform(x)),subtree,replace;

    a && b <=> b;

    a is true;
};

rule {
    attr level(0),problem_target(transform(x)),subtree,replace;

    a && b <=> a;

    a is false;
};

rule {
    attr level(1),problem_target(transform(x)),subtree,replace;

    a == b && c =>  a == b && replace(a == b, c);

    a is variable;
};

rule {
    attr level(3),problem_target(transform(x)),subtree,replace;

    a && (b || c) => (a && b) || (a && c);
};
