symbol && {
    attr infix(500),display("&"),associative,commutative;
}

rule a == c && b <=> b {
    attr level(2),goal(transform(x)),replace;

    a == c;
}

rule a != c && b <=> b {
    attr level(2),goal(transform(x)),replace;

    a != c;
}

rule a >= c && b <=> b {
    attr level(2),goal(transform(x)),replace;

    a >= c;
}

rule a <= c && b <=> b {
    attr level(2),goal(transform(x)),replace;

    a <= c;
}

rule a > c && b <=> b {
    attr level(2),goal(transform(x)),replace;

    a > c;
}

rule a < c && b <=> b {
    attr level(2),goal(transform(x)),replace;

    a < c;
}

rule a == c && b <=> a == c {
    attr level(2),goal(transform(x)),replace;

    a != c;
}

rule a != c && b <=> a != c {
    attr level(2),goal(transform(x)),replace;

    a == c;
}

rule a <= c && b <=> a <= c {
    attr level(2),goal(transform(x)),replace;

    a > c;
}

rule a >= c && b <=> a >= c {
    attr level(2),goal(transform(x)),replace;

    a < c;
}

rule a < c && b <=> a < c {
    attr level(2),goal(transform(x)),replace;

    a >= c;
}

rule a > c && b <=> a > c {
    attr level(2),goal(transform(x)),replace;

    a <= c;
}

rule a == b && c =>  a == b && substitute(a == b, c) {
    attr level(1),goal(transform(x)),replace;

    a is variable,
    b is known;
}

rule a && (b || c) => (a && b) || (a && c) {
    attr level(3),goal(transform(x)),replace;
}
