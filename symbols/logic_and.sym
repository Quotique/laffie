    a < c && b <=> b;

    a < c;
}

rule {
    attr level(2),goal(transform(x)),replace;

    a == c && b <=> a == c;

    a != c;
}

rule {
    attr level(2),goal(transform(x)),replace;

    a != c && b <=> a != c;

    a == c;
}

rule {
    attr level(2),goal(transform(x)),replace;

    a <= c && b <=> a <= c;

    a > c;
}

rule {
    attr level(2),goal(transform(x)),replace;

    a >= c && b <=> a >= c;

    a < c;
}

rule {
    attr level(2),goal(transform(x)),replace;

    a < c && b <=> a < c;

    a >= c;
}

rule {
    attr level(2),goal(transform(x)),replace;

    a > c && b <=> a > c;

    a <= c;
}

rule {
    attr level(1),goal(transform(x)),replace;

    a == b && c =>  a == b && replace(a == b, c);

    a is variable,
    b is known;
}

rule {
    attr level(3),goal(transform(x)),replace;

    a && (b || c) => (a && b) || (a && c);
}
