symbol ! {
    attr display("!");
}


rule !(a == b) <=> a != b {
    attr level(0),replace;
}

rule !(a != b) <=> a == b {
    attr level(0),replace;
}

rule !(a < b) <=> a >= b {
    attr level(0),replace;
}

rule !(a <= b) <=> a > b {
    attr level(0),replace;
}

rule !(a >= b) <=> a < b {
    attr level(0),replace;
}

rule !(a > b) <=> a <= b {
    attr level(0),replace;
}

rule !false <=> true {
    attr level(0),replace;
}
