symbol ! {
    attr display("!");
}


rule {
    attr level(0),replace;

    !(a == b) <=> a != b;
}

rule {
    attr level(0),replace;

    !(a != b) <=> a == b;
}

rule {
    attr level(0),replace;

    !(a < b) <=> a >= b;
}

rule {
    attr level(0),replace;

    !(a <= b) <=> a > b;
}

rule {
    attr level(0),replace;

    !(a >= b) <=> a < b;
}

rule {
    attr level(0),replace;

    !(a > b) <=> a <= b;
}

rule {
    attr level(0),replace;

    !false <=> true;
}
