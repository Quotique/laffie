symbol || {
    attr infix(600),display("|"),associative,commutative
};

rule {
    attr level(2),problem_target(transform(x)),subtree,replace;

    a || b <=> a;

    a is true;
};

rule {
    attr level(2),problem_target(transform(x)),subtree,replace;

    a || b <=> b;

    a is false;
};

rule {
    attr level(0),problem_target(find(x)),subtree,replace;

    x == a || x == b => answer(x in set(a, b));

    a is known,
    b is known;
};

rule {
    attr level(0),problem_target(find(x)),subtree,replace;

    x == a || x == b || x == c => answer(x in set(a, b, c));

    a is known,
    b is known,
    c is known;
};
