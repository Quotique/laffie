symbol - {
    attr infix(300)
};

rule {
    attr problem_target(transform),subtree,replace;

    [--a] <=> [a];
};

rule {
    attr problem_target(transform),subtree,replace;

    [a-b] => [a+(-b)];
};

rule {
    attr problem_target(proof([-a is known]));

    -a is known <=> [true];

    a is known
};
