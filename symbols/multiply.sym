symbol * {
    attr infix(200),display("·"),associative,commutative
}

rule {
    attr replace,level(2),purpose(transform(x));

    (a + b)*c <=> a*c + b*c;
}

rule {
    attr replace,level(4),purpose(transform(x));

    a*c + b*c + d <=> (a+b)*c + d;
}

rule {
    attr level(0),purpose(proof(a*b is known));

    a*b is known <=> true;

    a is known,
    b is known;
}

