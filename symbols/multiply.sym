symbol * {
    attr infix(200),display("·"),associative,commutative
};

rule {
    attr level(1),problem_target(transform(x));

    (a + b)*c <=> a*c + b*c;
};

rule {
    attr level(2),problem_target(transform(x));

    a*c + b*c + d <=> (a+b)*c + d;
};

rule {
    attr level(1),problem_target(transform(x));

    a*a*c <=> (a^2)*c;
};

rule {
    attr level(1),problem_target(transform(x));

    (a^n)*a*c <=> (a^(n+1))*c;
};
