symbol * {
    attr infix(200),display("·"),associative,commutative
}

rule {
    attr replace,level(2),purpose(transform(x)),id(brackets_disclosure);

    (a + b)*c <=> a*c + b*c;
}

rule {
    attr level(0),purpose(proof(a*b is known));

    a*b is known <=> true;

    a is known,
    b is known;
}

rule {
    attr level(0),purpose(transform(x)),replace;

    -(-a) <=> a;
}

rule {
    attr level(0),purpose(proof(-a is known));

    -a is known <=> true;

    a is known;
}

rule {
    attr level(1),purpose(transform(x)),replace;

    -a == -b <=> a == b;
}
