symbol ^ {
    attr infix(100)
}

rule {
    attr level(4),problem_target(find(x)),one(a),one(b),zero(c),block(move_left);

    a * x^2 + b * x + c == 0 => 
        (((b^2 - 4*a*c) as D) < 0 && x in empty_set) || 
        (D >= 0 && x in set( (-b+sqrt(D))/(2*a), (-b-sqrt(D))/(2*a) ));

    a != 0,
    c is known;
}

rule {
    attr level(4),problem_target(find(x)),one(a),one(b),zero(c);

    a * x^3 + b * x^2 + c * x == 0 => (x == 0) || (a * x^2 + b * x + c == 0);

    a != 0;
}

rule {
    attr replace,level(1),problem_target(transform(x));

    (a/b)^n <=> (a^n)/(b^n);
}

rule {
    attr replace,level(1),problem_target(transform(x)),one(c);

    (a^n)*a*c <=> (a^(n+1))*c;
}
