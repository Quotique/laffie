symbol ^ {
    attr infix(100);
}

rule {
    attr level(4),goal(find(x)),one(a),one(b),zero(b),zero(c),block(move_left);

    a * x^2 + b * x + c == 0 => 
        (((b^2 - 4*a*c) as D) < 0 && x in empty_set) || 
        (D >= 0 && x in set( (-b+sqrt(D))/(2*a), (-b-sqrt(D))/(2*a) ));

    a != 0,
    c is known;
}

rule {
    attr level(4),goal(find(x)),one(a),one(b),zero(c);

    a * x^3 + b * x^2 + c * x == 0 => (x == 0) || (a * x^2 + b * x + c == 0);

    a != 0;
}

// rule {
//     (x^3 + b * x^2 + c * x + d) as F == 0 => (u in y && replace(F, x = u) == 0) || F == 0;
// 
//     y = prime_factors(d);
// }

rule {
    attr level(4),goal(find(x)),one(a),one(b),zero(c);

    a * x^4 + b * x^3 + c * x^2 == 0 => (x == 0) || (a * x^2 + b * x + c == 0);

    a != 0;
}

rule {
    attr replace,level(1),goal(transform(x));

    (a/b)^n <=> (a^n)/(b^n);
}

// TODO: n is natural
rule {
    attr replace,level(4),goal(transform(x)),normalize(2);

    (a+b)^n <=> (a+b)^(n - 1)*(a + b);
}

rule {
    attr replace,level(1),goal(transform(x));

    (sqrt(a))^2 <=> a;

    a >= 0;
}

rule {
    attr replace,level(1),goal(transform(x));

    (-a)^2 <=> a^2;
}

rule {
    attr replace,level(3),goal(find(x)),one(a);

    a*x^2 == b => ( a*b >= 0 && x in set( sqrt(b/a), -sqrt(b/a) ) ) || 
                  ( a*b < 0 && x in empty_set );

    a != 0;
}
