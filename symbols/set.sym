symbol set {
    attr commutative;
}

// Нормализация формы множества в case-split-ветвях.
rule a in set(b) <=> a == b {
    attr level(3),goal(transform(x)),replace,block(move_left);
}

rule a in set(b, c) <=> a == b || a == c {
    attr level(3),goal(transform(x)),replace,block(move_left);
}

symbol empty_set {
    attr display("∅ ")
}
