symbol set {
    attr commutative
}

rule {
    attr level(0),problem_target(proof(set(a) is known));

    set(a) is known <=> true;

    a is known;
}

rule {
    attr level(0),problem_target(proof(set(a, ..) is known));

    set(a, .. as S) is known <=> true;

    a is known,
    set(S) is known;
}

rule {
    attr level(0),problem_target(find(x)),subtree,replace;

    x in set(a, b) => answer(x in set(a, b));

    a is known,
    b is known;
}

rule {
    attr level(3),problem_target(transform(x)),subtree,replace,block(move_left);

    a in set(b, c) <=> a == b || a == c;
}

symbol empty_set {
    attr display("∅ ")
}

rule {
    attr level(0),problem_target(proof(empty_set is known));

    empty_set is known <=> true;
}
