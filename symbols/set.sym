symbol set {
    attr commutative
};

rule {
    attr problem_target(proof([set(a) is known]));

    set(a) is known <=> [true];

    a is known
};

rule {
    attr problem_target(proof([set(a, b) is known]));
    
    set(a, b) is known <=> [true];

    a is known;
    b is known
};

symbol empty_set;

rule {
    attr problem_target(proof([empty_set is known]));

    empty_set is known <=> [true];
};
