symbol set {
    attr commutative
}

rule {
    attr level(0),purpose(proof(set(a) is known));

    set(a) is known <=> true;

    a is known;
}

rule {
    attr level(0),purpose(proof(set(a, ..) is known));

    set(a, .. as S) is known <=> true;

    a is known,
    set(S) is known;
}

// TODO: apply only to root
rule {
    attr level(0),purpose(find(x)),replace,id(answer_in_set),block(answer_in_set);

    x in set(a, b) => answer(x in set(a, b));

    a is known,
    b is known;
}

rule {
    attr level(3),purpose(transform(x)),replace,block(move_left);

    a in set(b, c) <=> a == b || a == c;
}

symbol empty_set {
    attr display("∅ ")
}

rule {
    attr level(0),purpose(proof(empty_set is known));

    empty_set is known <=> true;
}
