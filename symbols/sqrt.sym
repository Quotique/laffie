symbol sqrt {
    attr display("√");
}

rule {
    attr level(0),goal(prove(sqrt(a) is known));

    sqrt(a) is known <=> true;

    a is known;
}

// sqrt квадрата — модуль. Параметрический знак не теряется (в отличие
// от `(sqrt(a))^2 => a` с условием a >= 0).
rule {
    attr replace,level(1),goal(transform(x));

    sqrt(a^2) => abs(a);
}

rule {
    attr level(0),goal(prove(x != 0));

    a*sqrt(b) + c != 0 <=> c*a > 0 || b != (c/a)^2;

    b >= 0,
    a != 0;
}

rule {
    attr level(2),goal(find(x, ..)),one(a);

    a*sqrt(b) + c == 0 => a*c <= 0 && b == (c/a)^2;

    a != 0,
    c is known;
}

rule {
    attr level(3),goal(find(x, ..)),one(a),one(c),zero(d);

    a*sqrt(b) + c*x + d == 0 => a*(c*x + d) <= 0 && b == ((c*x + d)/a)^2;

    a != 0,
    d is known;
}

rule {
    attr level(4),goal(find(x, ..)),one(a),one(c);

    a*sqrt(b) + c*sqrt(d) == 0 => a*c <= 0 && a^2 * b == c^2 * d && b >= 0;

    a is known,
    c is known;
}

rule {
    attr level(4),goal(find(x, ..)),one(a),one(c),zero(e);

    a*sqrt(b) + c*sqrt(d) == e => a^2 * b == e^2 - 2*e*c*sqrt(d) + c^2*d && d >= 0 && b >= 0;

    a is known,
    c is known;
}

rule {
    attr level(2),goal(prove(x)),one(a);

    sqrt(a) <= b  <=> (b < 0 && a >= 0) || (b >= 0 && a >= 0 && a <= b^2);

    b is known;
}

rule {
    attr level(2),goal(prove(x)),one(a);

    sqrt(a) >= b <=> (b < 0 && a >= 0) || (b >= 0 && a >= b^2);

    b is known;
}

rule {
    attr level(2),goal(prove(x)),one(a);

    sqrt(a) > b <=> (b < 0 && a >= 0) || (b >= 0 && a > b^2);

    b is known;
}


rule {
    attr level(2),goal(prove(x <= 0)),one(a);

    a*sqrt(b) + c <= 0 <=> (a > 0 && sqrt(b) <= -c/a) || (a < 0 && sqrt(b) >= -c/a);

    a is known,
    a != 0;
}

rule {
    attr level(2),goal(prove(x > 0)),one(a);

    a*sqrt(b) + c > 0 <=> (a > 0 && sqrt(b) > -c/a) || (a < 0 && sqrt(b) < -c/a);

    a is known,
    a != 0;
}

// C29-форма: сумма двух радикалов `sqrt(x+p) + sqrt(x+q) = sqrt(r)`.
// Делегируем `solve_with_odz`: sympy решает формально, ОДЗ-фильтр на
// каждый кандидат подаёт `arg_i >= 0` после подстановки.
rule {
    attr level(2),goal(find(x, ..));

    sqrt(x + p) + sqrt(x + q) == sqrt(r) =>
        answer(solve_with_odz(sqrt(x + p) + sqrt(x + q) == sqrt(r), x));

    p is known,
    q is known;
}
