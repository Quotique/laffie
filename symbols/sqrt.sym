symbol sqrt {
    attr display("√")
}

rule {
    attr level(0),purpose(proof(sqrt(a) is known));

    sqrt(a) is known <=> true;

    a is known;
}

rule {
    attr level(0),purpose(proof(x != 0));

    a*sqrt(b) + c != 0 <=> c*a > 0 || b != (c/a)^2;

    b >= 0,
    a != 0;
}

