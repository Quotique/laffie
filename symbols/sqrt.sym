symbol sqrt {
    attr display("√");
}

// ОДЗ корня: над ℝ определён только при неотрицательном подкоренном.
rule sqrt(a) => domain(0 <= a) {
    attr id(domain_sqrt),premise;
}

// sqrt квадрата — модуль. Параметрический знак не теряется (в отличие
// от `(sqrt(a))^2 => a` с условием a >= 0).
rule sqrt(a^2) => abs(a) {
    attr replace,level(1),goal(transform(x));
}

rule a*sqrt(b) + c != 0 <=> c*a > 0 || b != (c/a)^2 {
    attr level(0),goal(prove(x != 0));

    b >= 0,
    a != 0;
}

rule a*sqrt(b) + c == 0 => a*c <= 0 && b == (c/a)^2 {
    attr level(2),goal(find(x, ..)),one(a);

    a != 0,
    c is known;
}

rule a*sqrt(b) + c*x + d == 0 => a*(c*x + d) <= 0 && b == ((c*x + d)/a)^2 {
    attr level(3),goal(find(x, ..)),one(a),one(c),zero(d);

    a != 0,
    d is known;
}

rule a*sqrt(b) + c*sqrt(d) == 0 => a*c <= 0 && a^2 * b == c^2 * d && b >= 0 {
    attr level(4),goal(find(x, ..)),one(a),one(c);

    a is known,
    c is known;
}

// Квадрат `a·√b = −(c·√d + e)` равносилен, только если знаки сторон совпадают.
// При `a·c < 0` их гарантирует ориентация с `a·e ≤ 0`, при `a·c > 0` — условие
// `a·e ≤ 0 ∧ c²·d − e² ≤ 0`: без корня и с нулём справа, чтобы его разобрали prove-правила.
rule a*sqrt(b) + c*sqrt(d) + e == 0 => a^2 * b == e^2 + 2*e*c*sqrt(d) + c^2*d && d >= 0 && b >= 0 {
    attr level(4),goal(find(x, ..)),one(a),one(c);

    a is known,
    c is known,
    e is known,
    a*c < 0,
    a*e <= 0;
}

rule a*sqrt(b) + c*sqrt(d) + e == 0 =>
    a*e <= 0 && c^2 * d - e^2 <= 0 && a^2 * b == e^2 + 2*e*c*sqrt(d) + c^2*d && d >= 0 && b >= 0
{
    attr level(4),goal(find(x, ..)),one(a),one(c);

    a is known,
    c is known,
    e is known,
    a*c > 0;
}

rule sqrt(a) <= b <=> b >= 0 && a >= 0 && a <= b^2 {
    attr level(2),goal(prove(x));

    b is known;
}

rule sqrt(a) >= b <=> (b < 0 && a >= 0) || (b >= 0 && a >= b^2) {
    attr level(2),goal(prove(x));

    b is known;
}

rule sqrt(a) > b <=> (b < 0 && a >= 0) || (b >= 0 && a > b^2) {
    attr level(2),goal(prove(x));

    b is known;
}

rule sqrt(a) < b <=> b > 0 && a >= 0 && a < b^2 {
    attr level(2),goal(prove(x));

    b is known;
}


rule a*sqrt(b) + c <= 0 <=> (a > 0 && sqrt(b) <= -c/a) || (a < 0 && sqrt(b) >= -c/a) {
    attr level(2),goal(prove(x <= 0)),one(a),zero(c);

    a is known,
    a != 0;
}

rule a*sqrt(b) + c > 0 <=> (a > 0 && sqrt(b) > -c/a) || (a < 0 && sqrt(b) < -c/a) {
    attr level(2),goal(prove(x > 0)),one(a),zero(c);

    a is known,
    a != 0;
}

rule a*sqrt(b) + c >= 0 <=> (a > 0 && sqrt(b) >= -c/a) || (a < 0 && sqrt(b) <= -c/a) {
    attr level(2),goal(prove(x >= 0)),one(a),zero(c);

    a is known,
    a != 0;
}

rule a*sqrt(b) + c < 0 <=> (a > 0 && sqrt(b) < -c/a) || (a < 0 && sqrt(b) > -c/a) {
    attr level(2),goal(prove(x < 0)),one(a),zero(c);

    a is known,
    a != 0;
}

// C29-форма: сумма двух радикалов `sqrt(x+p) + sqrt(x+q) = sqrt(r)`, уже
// перенесённая `move_left`. Делегируем `solve_with_odz`: sympy решает
// формально, ОДЗ-фильтр на каждый кандидат подаёт `arg_i >= 0` после подстановки.
rule sqrt(x + p) + sqrt(x + q) - sqrt(r) == 0 =>
    answer(solve_with_odz(sqrt(x + p) + sqrt(x + q) == sqrt(r), x))
{
    attr level(2),goal(find(x, ..));

    p is known,
    q is known;
}
