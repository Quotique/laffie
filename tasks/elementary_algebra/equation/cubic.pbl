task {
    purpose find(x);
    text "Решить уравнение 3x^3+2x^2-5x=0";
    answer  x in set((-5)/3, 0, 1), x == 0 || x == (-5)/3 || x == 1, x == 0 || x == 1 || -5/3;

    3*x^3 + 2*x^2 -5*x == 0;
}

task {
    purpose find(x);
    text "Решить уравнение (x-1)^3 + (2*x + 3)^3 == 27 * x^3 + 8";

    (x-1)^3+(2*x+3)^3 == 27*x^3+8;
}
