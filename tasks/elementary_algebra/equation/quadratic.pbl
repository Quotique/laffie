task {
    purpose find(x);
    text "Решить уравнение x^2+x-6=0";
    answer x == -3 || x == 2, x == 2 || x == -3;

    x^2+x-6 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение 3x^2+2x-5=0";
    answer x == (-5)/3 || x == 1, x == 1 || -5/3;

    3*x^2+2*x-5 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение 2x^2+2x+5=0";
    answer x in empty_set;

    2*x^2 + 2x + 5 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение x^2+2103x+2102=0";
    answer x == -2102 || x == -1, x == -1 || x == -2102;

    x^2 + 2103*x + 2102 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение 118x^2+1389x-1507=0";
    answer  x == (-1507)/118 || x == 1, x == 1 || x == (-1507)/118;

    118*x^2 + 1389x - 1507 == 0;
}

