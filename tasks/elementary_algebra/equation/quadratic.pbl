task {
    purpose find(x);
    text "Решить уравнение 299*x^2 + 100*x == 500 - 101*x^2";

    299*x^2 + 100*x == 500 - 101*x^2;
}

task {
    purpose find(x);
    text "Решить уравнение (2*x - 3)*(5*x + 1) == 2*x + 2/5";

    (2*x - 3)*(5*x + 1) == 2*x + 2/5;
}

task {
    purpose find(x);
    text "Решить уравнение (3*x - 1)*(x + 3) == x*(1 + 6*x)";

    (3*x - 1)*(x + 3) == x*(1 + 6*x);
}

