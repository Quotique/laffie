task {
    purpose find(x);
    text "Решить уравнение 1/(x-1) + 2/(x-2) + 3/(x-3) = 6/(x+6)";
    answer x == 1.2 || x == 2.4, x == 2.4 || x == 1.2;

    1/(x-1) + 2/(x-2) + 3/(x-3) == 6/(x+6);
}

task {
    purpose find(x);
    text "Решить уравнение 31( (24-5x)/(x+1) + (5-6x)/(x+4) ) + 370 = 29( (17-7x)/(x+2) + (8x+55)/(x+3) )";
    answer x == -2.5;

    31*( (24-5*x)/(x+1) + (5-6*x)/(x+4) ) + 370 == 29*( (17-7*x)/(x+2) + (8*x + 55)/(x+3)  );
}

task {
    purpose find(x);
    text "Решить уравнение (3x+7)/(5x+1) = (2x+1)/(x+4)";
    answer x == (-9)/7 || x == 3, x == 3 || x == (-9)/7;

    (3x + 7)/(5x + 1) == (2x + 1)/(x+4);
}

