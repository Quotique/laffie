    x in set(1, (sqrt(2) + 5)/2 );
}

task {
    purpose find(x);
    answer x == 1;

    --x == 1;
}

task {
    purpose find(x);
    answer x == -3;

    x+3 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение 2x+5=0";
    answer x == -2.5;

    2*x+5 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение 2x-5=0";
    answer x == 2.5;

    2*x-5 == 0;
}

task {
    purpose find(x);
    text "Решить уравнение 2(x+4)+3(x-5)=0";
    answer x == 1.4;

    2*(x+4) + 3*(x-5) == 0;
}

task {
    purpose find(x);
    text "Решить уравнение в зависимости от параметра 2x-5+t=0";
    answer x == (5-t)/2;

    2*x-5+t == 0;
    t is known;
}

task {
    purpose find(x);
    text "Решить уравнение в зависимости от параметра 2x-t=0";
    answer x == t/2;

    2*x-t == 0;
    t is known;
}

task {
    purpose find(x);
    text "Решить уравнение 3x+5=1-x";
    answer x == -1;

    3*x+5 == 1-x;
}
