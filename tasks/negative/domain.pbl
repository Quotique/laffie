// Инверсные ворота: ни одна задача решаться не должна. Нерешённая задача
// exit-код не роняет, поэтому ожидание проверяется grep-ом:
//   cli -c config/cli.yaml -p tasks/negative | grep '^total: solved: 0,'

task {
	goal prove(sqrt(a) > 4);
	text "ОДЗ собственную цель не закрывает";
}

task {
	goal prove(sqrt(a) < 0);
	text "ОДЗ даёт 0 <= a, обратное неравенство из него не следует";
}

task {
	goal prove(a < 0);
	text "спроецированное 0 <= a противоречит цели";

	sqrt(a) + 1 < 5;
}

task {
	goal prove(a > 5);
	text "оценка сильнее спроецированной";

	sqrt(a) + 1 < 5;
}

task {
	goal prove(a^(1/2) > 4);
	text "то же для дробной степени";
}

task {
	goal prove(1 == 2);
	text "ложное утверждение при живой записи ОДЗ";

	sqrt(a) + 1 < 5;
}

task {
	goal prove(b >= 0);
	text "проекция про другую переменную цель не закрывает";

	sqrt(a) + 1 < 5;
}

task {
	goal prove(a >= 0);
	text "нечётный корень условия не даёт";

	a^(1/3) + 1 < 5;
}

task {
	goal prove(a >= 0);
	text "целая степень условия не даёт";

	a^2 + 1 < 5;
}
