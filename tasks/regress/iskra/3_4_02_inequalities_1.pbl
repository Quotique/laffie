// 3.4.2. Доказательство неравенств - 1.

task {
    goal prove(a^10 - (a^7) + a^4 - (a^2) + 1 > 0);
    id "iskra:больше:60";

    a in Reals;
}

task {
    goal prove(0 <= a^2 + 2*a*b + 4*b^2);
    id "iskra:меньшеилиравно:045";

    b in Reals;
    a in Reals;
}

task {
    goal prove(4*a*b <= (a + b)^2);
    id "iskra:меньшеилиравно:051";

    b in Reals;
    a in Reals;
}

task {
    goal prove(2*a*(b + c) <= 2*a^2 + b^2 + c^2);
    id "iskra:меньшеилиравно:054";

    c in Reals;
    b in Reals;
    a in Reals;
}

task {
    goal prove(a*b + a*c + b*c <= a^2 + b^2 + c^2);
    id "iskra:меньшеилиравно:055";

    c in Reals;
    b in Reals;
    a in Reals;
}

task {
    goal prove((a + b + c)^2 <= 3*(a^2 + b^2 + c^2));
    id "iskra:меньшеилиравно:063";

    c in Reals;
    b in Reals;
    a in Reals;
}

task {
    goal prove(3*(a*b + b*c + c*a) <= (c + a + b)^2);
    id "iskra:меньшеилиравно:065";

    b in Reals;
    a in Reals;
    c in Reals;
    0 < c;
    0 < a;
    0 < b;
}

task {
    goal prove(6*a*b*c <= a*b*(a + b) + b*c*(b + c) + a*c*(a + c));
    id "iskra:меньшеилиравно:076";

    c in Reals;
    b in Reals;
    a in Reals;
    0 < a;
    0 < b;
    0 < c;
}

task {
    goal prove((a + b + c)^3 <= 9*(a^3 + b^3 + c^3));
    id "iskra:умножение:077";

    c in Reals;
    b in Reals;
    a in Reals;
    0 < a;
    0 < b;
    0 < c;
}

task {
    goal prove(0 <= a*b*(a + b - (2*c)) + b*c*(b + c - (2*a)) + a*c*(a + c - (2*b)));
    id "iskra:минус:076";

    c in Reals;
    a in Reals;
    b in Reals;
    0 < b;
    0 < a;
    0 < c;
}
