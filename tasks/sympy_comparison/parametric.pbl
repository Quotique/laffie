// Параметрические задачи sympy_comparison. Один файл, выбор отдельной
// задачи — по id: `cli --only c2`. Группа (для статистики) общая.

// C1 — параметрическое линейное уравнение a·x = a.
//
// Чистый sympy.solve(Eq(a*x, a), x) на 1.14.0 → [1] — теряется случай a = 0,
// в котором уравнение становится тождеством 0 = 0 и любой x подходит.
// Гибридный путь: case-split по a, делегирование sympy в ветви a != 0,
// явный x ∈ ℝ в ветви a == 0.
task {
    goal find(x);
    id "c1";
    text "C1 — параметрическое линейное a·x = a";
    answer (a == 0 && x in Reals) || (a != 0 && x in set(1)),
           (a == 0 && x in Reals) || (a != 0 && x == 1);

    a*x == a;
    a is known;
}

// C2 — параметрическое квадратное (a²−1)·x² + 2(a−1)·x + 1 == 0.
//
// SymPy 1.14.0: solve(...) возвращает пару корней с (a²−1) в знаменателе
// и 2−2a под корнем. В a = 1 обе формулы вырождаются (0/0), в a = −1
// знаменатель = 0. SymPy не разбирает старший коэффициент и не замечает,
// что при a = ±1 тип уравнения меняется. В a = 1 одновременно обнуляется
// и линейный коэффициент 2(a−1).
//
// Гибридный путь — двухуровневый case-split:
//   1) по обнулению старшего коэффициента (a²−1):
//      - a²−1 == 0 (т.е. a = ±1) — уравнение становится линейным или
//        тривиально-противоречивым;
//      - a²−1 ≠ 0 — обычное квадратное, делегируется sympy_solve.
//   2) внутри a²−1 == 0 — по обнулению линейного коэффициента 2(a−1):
//      - 2(a−1) == 0 (т.е. a = 1) — остаётся `1 = 0`, противоречие, ∅;
//      - 2(a−1) ≠ 0 (т.е. a = −1) — линейное −4x + 1 = 0, sympy → 1/4.
task {
    goal find(x);
    id "c2";
    text "C2 — параметрическое квадратное (a²−1)·x² + 2(a−1)·x + 1 == 0";
    // Каноническая форма (целевая для статьи). Свёртка от литеральной
    // (что laffie реально выдаёт) до канонической блокируется
    // nested-substitute-explosion в transform-фазе при compound LHS
    // (`a²-1 == 0`): substitute rule в logic_and.sym срабатывает на
    // compound LHS, requirement `a is variable` для compound — Truth::Unknown
    // (см. is.rs:33-42), что не блокирует создание гипотезы; substitute
    // calc возвращает no-op (map пустой), и rule re-fires, наслаивая
    // wrappers. Лечение — B3 в plan (param_solve как Rust-процедурный
    // символ): один вызов find на eq+param заменяет всё семейство.
    answer (a == 1 && x in empty_set) ||
           (a == -1 && x == 1/4) ||
           ((a != 1 && a != -1) && x == (-a + sqrt(2 - 2*a) + 1)/(a^2 - 1)) ||
           ((a != 1 && a != -1) && x == (-a - sqrt(2 - 2*a) + 1)/(a^2 - 1)),
           // Литеральная форма, которую laffie выдаёт сейчас.
           // Эквивалентна канонической; полная свёртка ждёт B3.
           (a^2 - 1 == 0 && 2*a - 2 == 0 && 1 == 0 && x in Reals) ||
           (0 != 1 && a^2 - 1 == 0 && 2*a - 2 == 0 && x in empty_set) ||
           (2*a - 2 != 0 && a^2 - 1 == 0 && x in set(-1/(-2 + 2*a))) ||
           (a^2 - 1 != 0 && x in set((1 - a - sqrt(2 - 2*a))/(-1 + a^2), (1 + sqrt(2 - 2*a) - a)/(-1 + a^2)));

    (a^2 - 1)*x^2 + 2*(a - 1)*x + 1 == 0;
    a is known;
}

// C24 — параметрическое линейное (a²−4)·x = a−2.
//
// SymPy 1.14.0: solve(...) → [1/(a + 2)], сокращает (a − 2) и теряет обе
// вырожденные ветви a = 2 (тождество, x ∈ ℝ) и a = -2 (противоречие, ∅).
// Гибрид: case-split правило для x*A + B == 0 с A = a² − 4, B = −(a − 2)
// должно ветвиться по A == 0 / A != 0; внутри A == 0 дополнительная
// конъюнкция с B == 0 / B != 0 разделит a = 2 от a = −2.
task {
    goal find(x);
    id "c24";
    text "C24 — параметрическое линейное (a²−4)·x = a−2";
    answer (a == 2 && x in Reals) ||
           (a == -2 && x in empty_set) ||
           ((a != 2 && a != -2) && x == 1/(a+2));

    (a^2 - 4)*x == a - 2;
    a is known;
}

// C26 — биквадратное с параметром x^4 − (a+1)·x^2 + a == 0.
//
// SymPy 1.14.0: solve(...) → [-1, 1, -sqrt(a), sqrt(a)] (без отбора по
// вещественности sqrt(a)). solveset(..., S.Reals) → невычисленный
// Intersection с Reals. factor(...) корректно даёт (x²−1)(x²−a).
//
// Гибридный путь — факторизация + case-split по знаку a:
//   1) Первый множитель x²−1 даёт x = ±1 без условий.
//   2) Второй множитель x²−a:
//      a > 0 — x = ±√a;
//      a = 0 — x = 0 (двойной);
//      a < 0 — нет вещественных корней.
// ЗАПАРКОВАНО: Path A (power.sym, биквадрат через подстановку y=x²) не
// сходится — поиск взрывается, прогон уходит в deadline. Раскомментировать
// при возврате к карточке (см. doc/ru/parametric_implementation_plan.md §B4).
// task {
//     goal find(x);
//     id "c26";
//     text "C26 — биквадратное x^4 − (a+1)·x^2 + a == 0";
//     answer (a >= 0 && x in set(-1, 1, sqrt(a), -sqrt(a))) ||
//            (a < 0 && x in set(-1, 1)),
//            // Литеральная форма, которую laffie реально выдаёт:
//            // case-split «x²=a» через `a·x²==b`-правило даёт две
//            // параметрические ветви, а `x²=1` редуцируется до плоского
//            // `x=1 | x=-1` (нет инфраструктуры свернуть в `x in set(±1)`
//            // на уровне дизъюнкции).
//            (a >= 0 && x in set(-sqrt(a), sqrt(a))) ||
//            (a < 0 && x in empty_set) ||
//            x == 1 || x == -1;
//
//     x^4 - (a + 1)*x^2 + a == 0;
//     a is known;
// }

// C29 — параметрическое иррациональное `√(x − a) + √(x + a) = √(2x)`.
//
// SymPy 1.14.0: solve(...) → [-a, a]; solveset(..., S.Reals) → {−|a|, |a|}.
// SymPy не выполняет ОДЗ-фильтр. Без него x = -a при a > 0 даёт ложный
// корень (нарушает x ≥ |a|).
//
// Гибридный путь — формальное решение + ОДЗ-фильтр:
//   1) ОДЗ из всех подкоренных: x - a ≥ 0, x + a ≥ 0, 2x ≥ 0 → x ≥ |a|.
//   2) Делегирование sympy_solve → кандидаты {-a, a}.
//   3) Постфильтр: оставить кандидаты, удовлетворяющие x ≥ |a|.
//      Для x = a: a ≥ |a| ≡ a ≥ 0.
//      Для x = -a: -a ≥ |a| ≡ a ≤ 0.
task {
    goal find(x);
    id "c29";
    text "C29 — параметрическое иррациональное √(x − a) + √(x + a) = √(2x)";
    answer (a == 0 && x == 0) ||
           (a != 0 && x == abs(a)),
           // Литеральная форма от solve_with_odz: case-split по знаку a
           // вместо abs. Эквивалент: at a=0 обе ветки дают x=0; иначе одна.
           (a <= 0 && x == -a) || (a >= 0 && x == a);

    sqrt(x - a) + sqrt(x + a) == sqrt(2*x);
    a is known;
}
