// C2 — параметрическое квадратное (a²−1)·x² + 2(a−1)·x + 1 == 0.
//
// SymPy 1.14.0: solve(...) возвращает пару корней с (a²−1) в знаменателе
// и 2−2a под корнем. В a = 1 обе формулы вырождаются (0/0), в a = −1
// знаменатель = 0. SymPy не разбирает старший коэффициент и не замечает,
// что при a = ±1 тип уравнения меняется. В a = 1 одновременно обнуляется
// и линейный коэффициент 2(a−1).
//
// Гибридный путь — двухуровневый case-split:
//   1) по обнулению старшего коэффициента (a²−1):
//      - a²−1 == 0 (т.е. a = ±1) — уравнение становится линейным или
//        тривиально-противоречивым;
//      - a²−1 ≠ 0 — обычное квадратное, делегируется sympy_solve.
//   2) внутри a²−1 == 0 — по обнулению линейного коэффициента 2(a−1):
//      - 2(a−1) == 0 (т.е. a = 1) — остаётся `1 = 0`, противоречие, ∅;
//      - 2(a−1) ≠ 0 (т.е. a = −1) — линейное −4x + 1 = 0, sympy → 1/4.

task {
    goal find(x);
    text "C2 — параметрическое квадратное (a²−1)·x² + 2(a−1)·x + 1 == 0";
    // Каноническая форма (целевая для статьи). Свёртка от литеральной
    // (что laffie реально выдаёт) до канонической блокируется
    // nested-substitute-explosion в transform-фазе при compound LHS
    // (`a²-1 == 0`): substitute rule в logic_and.sym срабатывает на
    // compound LHS, requirement `a is variable` для compound — Truth::Unknown
    // (см. is.rs:33-42), что не блокирует создание гипотезы; substitute
    // calc возвращает no-op (map пустой), и rule re-fires, наслаивая
    // wrappers. Лечение — B3 в plan (param_solve как Rust-процедурный
    // символ): один вызов find на eq+param заменяет всё семейство.
    answer (a == 1 && x in empty_set) ||
           (a == -1 && x == 1/4) ||
           ((a != 1 && a != -1) && x == (-a + sqrt(2 - 2*a) + 1)/(a^2 - 1)) ||
           ((a != 1 && a != -1) && x == (-a - sqrt(2 - 2*a) + 1)/(a^2 - 1)),
           // Литеральная форма, которую laffie выдаёт сейчас.
           // Эквивалентна канонической; полная свёртка ждёт B3.
           (a^2 - 1 == 0 && 2*a - 2 == 0 && 1 == 0 && x in Reals) ||
           (0 != 1 && a^2 - 1 == 0 && 2*a - 2 == 0 && x in empty_set) ||
           (2*a - 2 != 0 && a^2 - 1 == 0 && x in set(-1/(-2 + 2*a))) ||
           (a^2 - 1 != 0 && x in set((1 - a - sqrt(2 - 2*a))/(-1 + a^2), (1 + sqrt(2 - 2*a) - a)/(-1 + a^2)));

    (a^2 - 1)*x^2 + 2*(a - 1)*x + 1 == 0;
    a is known;
}
