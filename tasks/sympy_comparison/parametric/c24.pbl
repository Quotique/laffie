// C24 — параметрическое линейное (a²−4)·x = a−2.
//
// SymPy 1.14.0: solve(...) → [1/(a + 2)], сокращает (a − 2) и теряет обе
// вырожденные ветви a = 2 (тождество, x ∈ ℝ) и a = -2 (противоречие, ∅).
// Гибрид: case-split правило для x*A + B == 0 с A = a² − 4, B = −(a − 2)
// должно ветвиться по A == 0 / A != 0; внутри A == 0 дополнительная
// конъюнкция с B == 0 / B != 0 разделит a = 2 от a = −2.

task {
    goal find(x);
    text "C24 — параметрическое линейное (a²−4)·x = a−2";
    answer (a == 2 && x in Reals) ||
           (a == -2 && x in empty_set) ||
           ((a != 2 && a != -2) && x == 1/(a+2));

    (a^2 - 4)*x == a - 2;
    a is known;
}
