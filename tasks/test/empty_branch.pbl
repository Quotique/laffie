// Эмуляция формы ответа case-split: три ветви с конкретными конд-параметрами.
// Цель — убедиться, что существующая инфраструктура logic_and + logic_or
// корректно сворачивает дизъюнкцию вида
// (cond_1 && answer_1) || (cond_2 && answer_2) || (cond_3 && answer_3),
// когда из трёх условий ровно одно истинно. Никаких новых правил для этого
// добавлять не пришлось.

task {
    goal find(x);
    text "Case-split: истинная ветвь имеет ответ x = 7";
    answer x == 7;

    (5 == 2 && x in Reals) || (5 == 5 && x == 7) || (5 == 100 && x in empty_set);
}

task {
    goal find(x);
    text "Case-split: истинная ветвь имеет пустое множество";
    answer x in empty_set;

    (5 == 2 && x == 1) || (5 == 5 && x in empty_set) || (5 == 100 && x in Reals);
}

task {
    goal find(x);
    text "Case-split: истинная ветвь имеет x ∈ Reals";
    answer x in Reals;

    (5 == 2 && x == 1) || (5 == 5 && x in Reals) || (5 == 100 && x in empty_set);
}

