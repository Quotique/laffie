task {
    goal find(x);
    text "Решить уравнение -x^2+1 == 0";
    answer x == -1 || x == 1, x == 1 || x == -1;

    -x^2+1 == 0;
}

task {
    goal find(x);

    - 4 - 2*x <= 0 && -x^2 + 4*x == 0 && 2*x + 1 >= 0 && x >= 0;
}

task {
    goal find(x);
    text "Решить уравнение x^3 - 6x^2 + 11x - 6 = 0";
    answer x in set(1, 2, 3), x == 1 || x == 2 || x == 3;

    x^3 - 6*x^2 + 11*x - 6 == 0;
}

task {
    goal find(x, y);
    text "Решите систему уравнений: 2x - 6 = 0, 3y + 6 = 0";
    answer x == 3 && y == -2;

    2*x - 6 == 0;
    3*y + 6 == 0;
}

