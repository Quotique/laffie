// Цели вне охвата этапа 2 (см. doc/ru/inequalities.md). Держим как дорожную карту.

// Разворот бинома (transform раскрывает (x-1)^2) + проблема зависимостей.
task { goal prove((x-1)^2 + 3 > 2); }
task { goal prove(x^2 - 2*x + 1 >= 0); }

// Ограничение (а): цепочка goal-переписываний не строится (divide.sym к двум
// переменным не цепляется).
task { goal prove(x / y > 0);            x > 0; y > 0; }

// Форма E1 cmp E2 (сведение разности вне охвата) и/или sqrt.
task { goal prove(a^2 + b^2 >= 2*a*b); }
task { goal prove((a + b)/2 >= sqrt(a*b));       a >= 0; b >= 0; }

// Проблема зависимостей — правила не находят минимум (x = 1).
task { goal prove(x + 1/x >= 2);                 x > 0; }

// Модуль как оценка снизу переменной — вне текущих лемм.
task { goal prove(abs(x) >= x); }
