// Цели вне охвата этапа 2 (см. doc/ru/inequalities.md). Держим как дорожную карту.

// Нужен предикат чётности (is_even): безусловная неотрицательность чётной степени
// при неограниченной переменной. Версии с `x >= 0` — в tasks/test/ineq.pbl.
task { goal prove(x^4 >= 0); }
task { goal prove(x^2 + y^2 + 1 > 0); }

// Разворот бинома (transform раскрывает (x-1)^2) + проблема зависимостей.
task { goal prove((x-1)^2 + 3 > 2); }
task { goal prove(x^2 - 2*x + 1 >= 0); }

// Ограничение (а): цепочка goal-переписываний не строится (divide.sym к двум
// переменным не цепляется).
task { goal prove(x / y > 0);            x > 0; y > 0; }

// Монотонное произведение оценок: нужна лемма масштабирования (`2*y >= 6` из
// `y >= 3`); деление в требовании (`c > e/b`) роняет решатель при b=0.
task { goal prove(x * y > 6);            x > 2; y > 3; }

// Линейное убывание с верхней границей: правило `a<b => e-a>f` срабатывает и
// доказывает гипотезу, но `try_simplify` гонит `-x+6>0` в transform до
// усмотрения ответа (возня с отрицательным коэффициентом) — нужна правка ядра.
task { goal prove(6 - x > 0);            x < 5; }

// Форма E1 cmp E2 (сведение разности вне охвата) и/или sqrt.
task { goal prove(x * z > y * z);        x > y; z > 0; }
task { goal prove(a^2 + b^2 >= 2*a*b); }
task { goal prove((a + b)/2 >= sqrt(a*b));       a >= 0; b >= 0; }

// Проблема зависимостей — правила не находят минимум (x = 1).
task { goal prove(x + 1/x >= 2);                 x > 0; }

// Модуль как оценка снизу переменной — вне текущих лемм.
task { goal prove(abs(x) >= x); }
