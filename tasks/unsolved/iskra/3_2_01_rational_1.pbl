// 3.2.1. Рациональные уравнения - 1.

task {
    goal find(x);
    id "iskra:равно:010";
    answer (a != b && a + b + a*b^2 - (b^3) != 0 && a + b - (a*b^2) + b^3 != 0 && x == (a + b)/(a - b) || x != -(a^2) && x != a^2 && b == a) && x in Reals;

    (a^2 + x)/(b^2 - x) - ((a^2 - x)/(b^2 + x)) == (4*a*b*x + 2*a^2 - (2*b^2))/(b^4 - (x^2));
    b in Reals;
    a in Reals;
    a is known;
    b is known;
}

