// 3.2.2. Рациональные уравнения - 2.

task find(x) {
    id "iskra:вещественнаячасть:01";
    answer x == (-4 - ((9*sqrt(1033) + 325)^(1/3)) + (9*sqrt(1033) - 325)^(1/3))/3;

    x^3 + 4*x^2 - (4*x) + 14 == 0;
}

task find(x) {
    id "iskra:вхождениепеременной:1";
    answer x == (3*e^2 - d)/2;

    x == (a*b + a*c + b*c)/3;
    d in Reals;
    c in Reals;
    b in Reals;
    a in Reals;
    e in Reals;
    (a + b + c)/3 == e;
    (a^2 + b^2 + c^2)/3 == d;
    d is known;
    e is known;
}

task find(x) {
    id "iskra:минус:117";
    answer x == 1;

    x^3 + x^2 + x + x^(-1) + x^(-2) + x^(-3) == 6;
}

task find(x) {
    id "iskra:модуль:09";
    answer x == -1;

    abs(x - 3) + 2*abs(x + 1) == 4;
}

task find(x) {
    id "iskra:модуль:10";
    answer x == 7/12;

    abs(4*x - 1) == 1/(3*x - 1);
}

task find(x) {
    id "iskra:равно:002";
    answer x in empty_set;

    abs(2*x - 9) + abs(x + 3) == abs(x - 1);
}

task find(x) {
    id "iskra:равно:031";
    answer (a != 0 && b != 0 && a*b != 1 && x == 1/b || x != 0 && a == 0) && x in Reals;

    (x + a)/(a - x) == (a*b + 1)/(a*b - 1);
    b in Reals;
    a in Reals;
    a is known;
    b is known;
}

task find(x) {
    id "iskra:равно:082";
    answer a != 0 && (a != -1 && a != -2 && x == (a - (a^2) - sqrt(-(a*6) - (2*a^3) - (9*a^2) + 1 + a^4) + 1)/(a*2) || x == (a - (a^2) + 1 + sqrt(-(a*6) - (2*a^3) - (9*a^2) + 1 + a^4))/(a*2)) && -1 <= -(a*6) - (2*a^3) - (9*a^2) + a^4 || a == 0 && x == 2;

    (a*x + 1)/(x - 1) + (x - 2)/(x + a) == 1;
    a in Reals;
    a is known;
}

task find(x) {
    id "iskra:равно:200";
    answer (a + b != 0 && x == a - b || a == -b) && x in Reals;

    a^2 - (b^2) == x*(a + b);
    a in Reals;
    b in Reals;
    a is known;
    b is known;
}

task find(x) {
    id "iskra:редакцияпрограммы:02";
    answer x == 1/(-1 + 2^(2/3));

    x^3 - (x^2) - x == 1/3;
}

task find(x) {
    id "iskra:число:031";
    answer a != 0 && (a != -2 && x == a*(-a - 4 + sqrt(a*4 + 20 + a^2))/2 || x == -(a*(a + 4 + sqrt(a*4 + 20 + a^2))/2));

    (a^2 + 2*x)/(x - a) == (x - a)/(x + a);
    a in Reals;
    a is known;
}

task find(x) {
    id "iskra:число:032";
    answer a != 0 && x == a/2;

    (2*a^2 + x^2)/(a^3 - (x^3)) - (2*x/(a*x + a^2 + x^2)) + 1/(x - a) == 0;
    a in Reals;
    a is known;
}

task find(x) {
    id "iskra:числокорней:04";
    answer x == -(7/2);

    1/(x + 2) + 1/(x + 5) + 1/(x + 7) + 1/x == 1/(x + 1) + 1/(x + 3) + 1/(x + 4) + 1/(x + 6);
}

