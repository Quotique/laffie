// 3.2.8. Системы алгебраических уравнений - 4.

task find(x, y, z) {
    id "iskra:Подчинено:05";
    answer c != 0 && a != 0 && b != 0 && (x == -(sqrt(c*a*b*(c*a + c*b + a*b))/(a*b)) && y == -(sqrt(c*a*b*(c*a + c*b + a*b))/(c*b)) && z == -(sqrt(c*a*b*(c*a + c*b + a*b))/(c*a)) || x == sqrt(c*a*b*(c*a + c*b + a*b))/(a*b) && y == sqrt(c*a*b*(c*a + c*b + a*b))/(c*b) && z == sqrt(c*a*b*(c*a + c*b + a*b))/(c*a)) && 0 < c*a*b*(c*a + c*b + a*b);

    y + z == (a + b)*(1/x + 1/y + 1/z);
    x + z == (c + b)*(1/x + 1/y + 1/z);
    x + y == (c + a)*(1/x + 1/y + 1/z);
    c in Reals;
    b in Reals;
    a in Reals;
    a + b != 0;
    c + b != 0;
    c + a != 0;
    a is known;
    b is known;
    c is known;
}

task find(x, y, z, u, v) {
    id "iskra:Слагаемое:04";
    answer z in Reals && u == (y*3 - (z*4) - 6)/2 && x == -(y*7/2) + 6 && v == y - 2 && y in Reals;

    6*z + 3*u + 2*v + 3*x + 4*y == 5;
    4*z + 2*u + v + 2*x + 3*y == 4;
    4*z + 2*u + 3*v + 2*x + y == 0;
    2*z + u + 7*v + 3*x + 2*y == 1;
}

task find(x, y, z) {
    id "iskra:Слагаемое:18";
    answer x == -1 && y == -1 && z == -1 || x == 1 && y == 1 && z == 1;

    x^2 - (x*y) - (x*z) + z^2 == 0;
    x^2 - (x*z) - (y*z) + 3*y^2 == 2;
    y^2 + x*y + y*z - (z^2) == 2;
}

task find(x, y) {
    id "iskra:вхождение:5";
    answer x == 2 && y == 1 || x == 2/5 && y == -(1/5);

    5*x*(1/(x^2 + y^2) + 1) == 12;
    5*y*(-(1/(x^2 + y^2)) + 1) == 4;
}

task find(x, y, z) {
    id "iskra:имя:01";
    answer y == -10 && z == -5 && x == 1;

    sqrt(x - 1) + y == 2*z;
    sqrt(-(x^2) - x + 2) - (2*y) + 3*z == 5;
}

task find(x, y, z) {
    id "iskra:инфперем:01";
    answer a + b - c != 0 && b + c - a != 0 && b - a - c != 0 && x == (b*c*2 + 3*a^2 - (a*b*2) - (a*c*2) - (b^2) - (c^2))/((a + c - b)*(b + c - a)*(c - a - b)) && y == (a*c*2 + 3*b^2 - (a*b*2) - (b*c*2) - (a^2) - (c^2))/((a + c - b)*(b + c - a)*(c - a - b)) && z == (a*c*2 + b*c*2 - (a*b*2) - (3*c^2) + a^2 + b^2)/((a + b - c)*(a + c - b)*(b + c - a)) || x == 0 && y == 0 && z == 0;

    y + 2*x + z == a*(x + y)*(z + x);
    z + 2*y + x == b*(y + z)*(x + y);
    x + 2*z + y == c*(z + x)*(y + z);
    c in Reals;
    b in Reals;
    a in Reals;
    a is known;
    b is known;
    c is known;
}

task find(x, y) {
    id "iskra:кривая:02";
    answer x == -((5/4)^(1/5)) && y == -(50^(1/5)) || x == 0 && y == 0 || x == 1 && y == 1;

    4*x^2 - (3*y) == x*y^3;
    x^3*y^2 + x^2 == 2*y;
}

task find(x, y) {
    id "iskra:мультивставка:3";
    answer x == -1 && y == 1 || x == -(2/3^(1/3)) && y == -(2*3^(1/3)) || x == 0 && y == 0;

    x*y^2 + 3*x^2 - (2*y) == 0;
    x^2*y + y^2 + 2*x == 0;
}

task find(x, y) {
    id "iskra:нижнийпредел:09";
    answer x == -27 && y == -216 || x == 216 && y == 27;

    x - y == (7/2)*(-((x*y^2)^(1/3)) + (x^2*y)^(1/3));
    -(y^(1/3)) + x^(1/3) == 3;
}

task find(x, y) {
    id "iskra:преобразователь:06";
    answer y == b - a && x == b + a && a != 0 && b != 0;

    2*a^2/b + 2*b == y*(-(a/b) + 1) + x*(a/b + 1);
    2*b/a - (2*b*a) == x*(1/a - b) + y*(1/a + b);
    a in Reals;
    b in Reals;
    a is known;
    b is known;
}

task find(x, y, z) {
    id "iskra:просмотртерма:01";
    answer a == 0 && x == 0 && y == 0 && z == 0;

    x + y + z == a;
    x*y + x*z + y*z == a^2;
    x*y*z == a^3;
    a in Reals;
    a is known;
}

task find(x, y, z) {
    id "iskra:сдвигзапятой:13";
    answer x == -sqrt(b*c/a) && y == -sqrt(b*a/c) && z == -sqrt(a*c/b) || x == sqrt(b*c/a) && y == sqrt(b*a/c) && z == sqrt(a*c/b);

    -(a/z) + b/x == -(z*x) + c;
    -(c/x) + a/y == -(x*y) + b;
    -(b/y) + c/z == -(y*z) + a;
    c in Reals;
    a in Reals;
    b in Reals;
    0 < b;
    0 < a;
    0 < c;
    a is known;
    b is known;
    c is known;
}

task find(x, y, z, u) {
    id "iskra:смешаннаядробь:02";
    answer x == u*2 + 1 && z == -(u*4 + 1) && y == -(u*3) + 1 && u in Reals;

    y + 2*z + 5*u + 3*x == 2;
    2*y + 3*z + 26*u - (4*x) == -5;
    3*y - (4*z) - (9*u) + x == 8;
    -(4*y) + z - (12*u) + 2*x == -3;
}

task find(x, y) {
    id "iskra:теоремы:02";
    answer x == 3 && y == 2;

    y - (2*x) + 6 == (sqrt(x - y - 1) + 4*sqrt(x - y))/(y + 2*x - 6);
    sqrt(x - y) + y^2 == sqrt(x - y - 1) - ((x - 3)^2) + 5;
}

task find(x, y) {
    id "iskra:точкаграфа:2";
    answer x == -sqrt(2) && y == sqrt(2) || x == -sqrt(3) && y == sqrt(3) || x == -sqrt(6) && y == -sqrt(6) || x == sqrt(2) && y == -sqrt(2) || x == sqrt(3) && y == -sqrt(3) || x == sqrt(6) && y == sqrt(6);

    -(5*y^2/x) + x^3 == 6/y;
    -(5*x^2/y) + y^3 == 6/x;
}

task find(x, y) {
    id "iskra:треугольник:02";
    answer x == -1 && y == 0 || x == 0 && y == 1 || x == 1 && y == -2 || x == 2 && y == -1;

    -((2*x + y)/(x^2 - (y^2))) + x == 1;
    (x + 2*y)/(x^2 - (y^2)) + y == -1;
}

task find(x, y, z) {
    id "iskra:учетпосылок:01";
    answer b != 0 && c != 0 && (x == -(b*c/sqrt(b*a*c)) && y == -(sqrt(b*a*c)/c) && z == -(sqrt(b*a*c)/b) || x == b*c/sqrt(b*a*c) && y == sqrt(b*a*c)/c && z == sqrt(b*a*c)/b) && 0 < b*a*c;

    -(a/z) + b/x + x*z == c;
    -(c/x) + a/y + x*y == b;
    -(b/y) + c/z + y*z == a;
    c in Reals;
    a in Reals;
    b in Reals;
    a is known;
    b is known;
    c is known;
}

