// 3.4.1. Доказательство тождеств.

task {
    goal prove(sqrt(sqrt(a) + b) == sqrt((-sqrt(b^2 - a) + b)/2) + sqrt((sqrt(b^2 - a) + b)/2));
    id "iskra:дробь:076";

    a in Reals;
    b in Reals;
}

task {
    goal prove(a^2/(b + c) + b^2/(c + a) + c^2/(a + b) == 0);
    id "iskra:область:15";

    c in Reals;
    b in Reals;
    a in Reals;
    a/(b + c) + b/(c + a) + c/(a + b) == 1;
}

task {
    goal prove(a*b*c != 0);
    id "iskra:равно:001";

    a < 0;
    b < 0;
    0 < c;
    a in Reals;
    b in Reals;
    c in Reals;
}

