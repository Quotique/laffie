// 3.4.4. Доказательство неравенств - 3.

task prove(sqrt(a*b*(a + b)) + sqrt(b*c*(b + c)) + sqrt(a*c*(a + c)) > sqrt((a + b)*(b + c)*(a + c) + 4*a*b*c)) {
    id "iskra:континуум:16";

    c in Reals;
    b in Reals;
    a in Reals;
    0 < a;
    0 < b;
    0 < c;
}

task prove(2*sqrt(2) <= (a^2 + b^2)/(a - b)) {
    id "iskra:нормодз:10";

    b in Reals;
    a in Reals;
    a > b;
    a*b == 1;
}

task prove(2^(5/4)/(a + b)^(1/4) <= 1/a^(1/4) + 1/b^(1/4)) {
    id "iskra:установка:11";

    b in Reals;
    a in Reals;
    0 < a;
    0 < b;
}

